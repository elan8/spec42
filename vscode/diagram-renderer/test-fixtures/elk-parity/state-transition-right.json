{
  "id": "state-transition",
  "layoutOptions": {
    "elk.algorithm": "layered",
    "elk.edgeRouting": "ORTHOGONAL",
    "elk.layered.nodePlacement.strategy": "NETWORK_SIMPLEX",
    "elk.separateConnectedComponents": "true",
    "elk.json.edgeCoords": "ROOT",
    "elk.hierarchyHandling": "INCLUDE_CHILDREN",
    "elk.layered.crossingMinimization.strategy": "LAYER_SWEEP",
    "elk.layered.spacing.nodeNodeBetweenLayers": "230",
    "elk.spacing.nodeNode": "190",
    "elk.spacing.edgeNode": "130",
    "elk.spacing.edgeEdge": "110",
    "elk.spacing.edgeLabel": "12",
    "elk.padding": "[top=100,left=90,bottom=90,right=90]",
    "elk.direction": "RIGHT"
  },
  "children": [
    {
      "id": "initial",
      "width": 34,
      "height": 34
    },
    {
      "id": "idle",
      "width": 240,
      "height": 180
    },
    {
      "id": "active",
      "width": 240,
      "height": 180
    },
    {
      "id": "fault",
      "width": 240,
      "height": 180
    },
    {
      "id": "final",
      "width": 34,
      "height": 34
    }
  ],
  "edges": [
    {
      "id": "s1",
      "sources": [
        "initial"
      ],
      "targets": [
        "idle"
      ]
    },
    {
      "id": "s2",
      "sources": [
        "idle"
      ],
      "targets": [
        "active"
      ],
      "labels": [
        {
          "id": "s2::label",
          "text": "start [ready] / engage",
          "width": 140,
          "height": 16,
          "layoutOptions": {
            "org.eclipse.elk.edgeLabels.placement": "CENTER",
            "org.eclipse.elk.edgeLabels.inline": "false"
          }
        }
      ]
    },
    {
      "id": "s3",
      "sources": [
        "active"
      ],
      "targets": [
        "fault"
      ],
      "labels": [
        {
          "id": "s3::label",
          "text": "failure",
          "width": 50,
          "height": 16,
          "layoutOptions": {
            "org.eclipse.elk.edgeLabels.placement": "CENTER",
            "org.eclipse.elk.edgeLabels.inline": "false"
          }
        }
      ]
    },
    {
      "id": "s4",
      "sources": [
        "active"
      ],
      "targets": [
        "idle"
      ],
      "labels": [
        {
          "id": "s4::label",
          "text": "stop",
          "width": 38,
          "height": 16,
          "layoutOptions": {
            "org.eclipse.elk.edgeLabels.placement": "CENTER",
            "org.eclipse.elk.edgeLabels.inline": "false"
          }
        }
      ]
    },
    {
      "id": "s5",
      "sources": [
        "fault"
      ],
      "targets": [
        "final"
      ]
    }
  ]
}
